{
	"schemaVersion": 1,
	"id": "panacea",
	"version": "${version}",
	"name": "Panacea",
	"description": "An overhaul of Minecraft's magic systems, filling the gaps in enchanting and potion-making.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/panacea/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.aura.panacea.Panacea"
		],
		"client": [
			"com.aura.panacea.client.PanaceaClient"
		]
	},
	"mixins": [
		"panacea.mixins.json",
		{
			"config": "panacea.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}